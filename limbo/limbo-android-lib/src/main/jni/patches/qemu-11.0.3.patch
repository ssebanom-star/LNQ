diff --git a/meson.build b/meson.build
index c55f601d6..f3d43f5fb 100644
--- a/meson.build
+++ b/meson.build
@@ -1360,10 +1360,18 @@ if get_option('spice') \
 endif
 spice_headers = spice.partial_dependency(compile_args: true, includes: true)
 
+# __LIMBO__: Android's libc (bionic) has no separate librt -- everything that
+# glibc puts there lives in libc -- and it provides no POSIX shared memory.
+# Requiring librt would abort configuration, so probe for bionic and skip it.
+# qemu_shm_alloc() is stubbed out for bionic in util/oslib-posix.c.
+# __BIONIC__ comes from <sys/cdefs.h>, it is not a compiler builtin, so the
+# header has to be pulled in for the probe to see it.
+have_bionic = cc.get_define('__BIONIC__', prefix: '#include <sys/cdefs.h>') != ''
+
 rt = not_found
 if host_os != 'windows'
   have_shm_open = cc.has_function('shm_open')
-  if not have_shm_open
+  if not have_shm_open and not have_bionic
     rt = cc.find_library('rt', required: true)
   endif
 endif
@@ -2455,6 +2463,8 @@ config_host_data.set('CONFIG_FUZZ', get_option('fuzzing'))
 config_host_data.set('CONFIG_GCOV', get_option('b_coverage'))
 config_host_data.set('CONFIG_LIBUDEV', libudev.found())
 config_host_data.set('CONFIG_LINUX', host_os == 'linux')
+# __LIMBO__: distinguishes Android's bionic libc from glibc/musl on Linux.
+config_host_data.set('CONFIG_BIONIC', have_bionic)
 config_host_data.set('CONFIG_POSIX', host_os != 'windows')
 config_host_data.set('CONFIG_WIN32', host_os == 'windows')
 config_host_data.set('CONFIG_LZO', lzo.found())
@@ -4446,14 +4456,34 @@ foreach target : target_dirs
       exe_name += '-unsigned'
     endif
 
-    emulator = executable(exe_name, exe['sources'],
-               install: true,
-               c_args: c_args,
-               dependencies: arch_deps + exe['dependencies'],
-               objects: lib.extract_all_objects(recursive: true),
-               link_depends: [block_syms, qemu_syms],
-               link_args: link_args,
-               win_subsystem: exe['win_subsystem'])
+    # __LIMBO__: on Android the emulator is dlopen()ed by the app instead of
+    # being exec'd, so emit lib<name>.so rather than an executable.  The
+    # object set is identical -- only the link mode differs.  system/main.c's
+    # main() stays in the library and is simply never called; Limbo's JNI
+    # bridge calls qemu_init()/qemu_main_loop()/qemu_cleanup() itself.
+    if get_option('shared_emulator') and target.endswith('-softmmu')
+      emulator = shared_library(exe_name, exe['sources'],
+                 install: true,
+                 c_args: c_args,
+                 dependencies: arch_deps + exe['dependencies'],
+                 objects: lib.extract_all_objects(recursive: true),
+                 link_depends: [block_syms, qemu_syms],
+                 link_args: link_args,
+                 # Android's package installer only extracts unversioned
+                 # lib*.so from an APK, so neither version nor soversion may
+                 # be set here -- meson then emits a plain lib<name>.so.
+                 name_prefix: 'lib',
+                 name_suffix: 'so')
+    else
+      emulator = executable(exe_name, exe['sources'],
+                 install: true,
+                 c_args: c_args,
+                 dependencies: arch_deps + exe['dependencies'],
+                 objects: lib.extract_all_objects(recursive: true),
+                 link_depends: [block_syms, qemu_syms],
+                 link_args: link_args,
+                 win_subsystem: exe['win_subsystem'])
+    endif
 
     if host_os == 'darwin'
       icon = 'pc-bios/qemu.rsrc'
