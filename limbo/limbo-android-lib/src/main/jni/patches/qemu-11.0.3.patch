diff --git a/include/scsi/constants.h b/include/scsi/constants.h
index 717e470a5..9c1dcf757 100644
--- a/include/scsi/constants.h
+++ b/include/scsi/constants.h
@@ -167,6 +167,26 @@
  *  SAM Status codes
  */
 
+/*
+ * __LIMBO__: Android's <scsi/sg.h> (dragged in by scsi/utils.h) defines these
+ * same names, which glibc's copy does not. Worse, bionic uses the unshifted
+ * encoding (CHECK_CONDITION 0x01) while QEMU uses the SAM left-shifted one
+ * (0x02), so letting the platform definitions win would silently corrupt
+ * ATAPI/SCSI status bytes -- and with -Werror=macro-redefined it does not
+ * even compile. Drop the platform's definitions and use QEMU's.
+ */
+#undef GOOD
+#undef CHECK_CONDITION
+#undef CONDITION_GOOD
+#undef BUSY
+#undef INTERMEDIATE_GOOD
+#undef INTERMEDIATE_C_GOOD
+#undef RESERVATION_CONFLICT
+#undef COMMAND_TERMINATED
+#undef TASK_SET_FULL
+#undef ACA_ACTIVE
+#undef TASK_ABORTED
+
 #define GOOD                 0x00
 #define CHECK_CONDITION      0x02
 #define CONDITION_GOOD       0x04
